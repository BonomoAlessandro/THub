{
  "name": "termhub",
  "productName": "TermHub",
  "version": "0.1.0",
  "description": "Mehrere benannte Terminal-Sessions in einem Fenster, die beim Neustart wiederhergestellt werden.",
  "main": "dist/main/main.js",
  "private": true,
  "scripts": {
    "build": "node build.mjs",
    "start": "node build.mjs && electron .",
    "dev": "node build.mjs --dev && electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:shells": "vitest run --config test/shells/vitest.config.mts",
    "dist": "node build.mjs && electron-builder --win"
  },
  "build": {
    "appId": "ch.custom.termhub",
    "productName": "TermHub",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "npmRebuild": false,
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    }
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
